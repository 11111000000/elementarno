{
  "pack": "garden",
  "title": "Сад и участок: земля, инструмент, вода",
  "rules": [
    {
      "id": "GRD-001",
      "version": 1,
      "pack": "garden",
      "title": "Взрыхлённый грунт",
      "domain": "garden",
      "layer": "epistemic",
      "severity": "notice",
      "requires": [
        "regions"
      ],
      "depends_on": [],
      "predicate": {
        "kind": "all",
        "conditions": [
          {
            "kind": "count",
            "path": "regions[kind=disturbed_dust]",
            "gte": 1
          },
          {
            "kind": "count",
            "path": "surfaces[material=soil]",
            "gte": 1
          },
          {
            "kind": "absent",
            "path": "regions[kind=footprint]"
          }
        ]
      },
      "inference": {
        "claim": "Грунт разрыхлён и перекопан: здесь работали с землёй",
        "confidence_prior": 0.55,
        "confidence_ceiling": 0.65,
        "step": "activity",
        "tags": [
          "gardening",
          "soil_work"
        ]
      },
      "anchors": [
        "regions[kind=disturbed_dust].id"
      ],
      "confounds": [
        "Полосы могли оставить дождевые потоки или когти животного",
        "Землю могли перекопать давно и забыть",
        "Следы животных и размытые края тоже оставляют «взрыхлённый» вид грунта"
      ],
      "exceptions": [
        "Полосы извилистые и без параллельной структуры"
      ],
      "falsification": {
        "refuted_by": [],
        "physical_test": "Сравнить шаг и ширину полос с рабочим инструментом"
      },
      "sources": [
        {
          "ref": "OSAC Registry, NIST — Trace Evidence",
          "note": "частицы и следы как следовые материалы; конкретный стандарт уточняет эксперт",
          "verified": false
        }
      ],
      "review_status": "draft"
    },
    {
      "id": "GRD-003",
      "version": 1,
      "pack": "garden",
      "title": "Следы по грунту, в стороне от дорожки",
